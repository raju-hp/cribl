# Local .terraform directories
**/.terraform/*
.terraform.lock.hcl

# Terraform state files
terraform.tfstate
terraform.tfstate.*
*.tfstate.backup

# Crash logs
crash.log
crash.*.log

# Exclude all .tfvars files since they may contain secrets
# *.tfvars
# *.tfvars.json

# Override files (sensitive or environment-specific)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Local environment files
.env
.env.*

# Editor and OS files
*.swp
*.swo
*.DS_Store
*.idea/
*.vscode/
*.history/
*.bak
*~
Thumbs.db

# Log and output directories
logs/
output/
*.log

# SSH keys or sensitive files
*.pem
*.key
*.crt
*.csr

# Lock and temp files
*.lock
*.tmp
